local function pushDisplayName(plr, text)
	if not plr or text == nil or text == "" then
		return
	end
	if origDisplay[plr] == nil then
		local ok, current = pcall(function()
			return plr.DisplayName
		end)
		origDisplay[plr] = ok and current or plr.Name
	end
	pcall(function()
		if setscriptable then
			setscriptable(plr, "DisplayName", true)
		end
	end)
	pcall(function()
		if plr.DisplayName ~= text then
			plr.DisplayName = text
		end
	end)
end

local function restoreDisplays()
	for plr, name in pairs(origDisplay) do
		if typeof(plr) == "Instance" and plr.Parent then
			pcall(function()
				plr.DisplayName = name
			end)
		end
	end
	table.clear(origDisplay)
end

local function restoreSpoof()
	for label, original in pairs(spoofOriginal) do
		if typeof(label) == "Instance" and label.Parent then
			pcall(function()
				label.Text = original
			end)
		end
	end
	table.clear(spoofOriginal)
	table.clear(spoofWatch)
	restoreDisplays()
	if hum then
		pcall(function()
			hum.DisplayName = LP.DisplayName
		end)
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and plr.Character then
			local h = plr.Character:FindFirstChildOfClass("Humanoid")
			if h then
				pcall(function()
					h.DisplayName = plr.DisplayName
				end)
			end
		end
	end
end

local function replacePlain(s, from, to)
	if not from or from == "" or not string.find(s, from, 1, true) then
		return s
	end
	local out, i = {}, 1
	while true do
		local a, b = string.find(s, from, i, true)
		if not a then
			out[#out + 1] = string.sub(s, i)
			break
		end
		out[#out + 1] = string.sub(s, i, a - 1)
		out[#out + 1] = to
		i = b + 1
	end
	return table.concat(out)
end

local function labelMatches(text, plr)
	if type(text) ~= "string" or text == "" then
		return false
	end
	local plain = text:gsub("<.->", "")
	local saved = origDisplay[plr]
	if plain == plr.Name or plain == plr.DisplayName or plain == "@" .. plr.Name or plain == "@" .. plr.DisplayName then
		return true
	end
	if saved and (plain == saved or plain == "@" .. saved) then
		return true
	end
	if #plain <= 96 then
		if #plr.DisplayName >= 3 and string.find(plain, plr.DisplayName, 1, true) then
			return true
		end
		if saved and #saved >= 3 and saved ~= plr.DisplayName and string.find(plain, saved, 1, true) then
			return true
		end
		if #plr.Name >= 3 and plr.Name ~= plr.DisplayName and string.find(plain, plr.Name, 1, true) then
			return true
		end
	end
	return false
end

local function desiredSpoof(plr)
	if plr == LP then
		return CFG.spoofSelfName
	end
	return CFG.spoofEnemyName
end

local function paintSpoofLabel(label, plr, replacement)
	if replacement == "" or not label or not label.Parent then
		return
	end
	local original = spoofOriginal[label]
	local basis = original or label.Text
	if not labelMatches(basis, plr) and not labelMatches(label.Text, plr) then
		return
	end
	if original == nil then
		spoofOriginal[label] = label.Text
		basis = label.Text
	end
	local plain = basis:gsub("<.->", "")
	local saved = origDisplay[plr]
	local nextText
	if plain == plr.Name or plain == plr.DisplayName or plain == "@" .. plr.Name or plain == "@" .. plr.DisplayName or plain == saved or (saved and plain == "@" .. saved) then
		nextText = replacement
	else
		nextText = basis
		if saved and #saved >= 3 then
			nextText = replacePlain(nextText, saved, replacement)
		end
		if #plr.DisplayName >= 3 and plr.DisplayName ~= replacement then
			nextText = replacePlain(nextText, plr.DisplayName, replacement)
		end
		if #plr.Name >= 3 and plr.Name ~= plr.DisplayName then
			nextText = replacePlain(nextText, plr.Name, replacement)
		end
	end
	if label.Text ~= nextText then
		label.Text = nextText
	end
end

local function collectText(root, into)
	if not root then
		return
	end
	if root:IsA("TextLabel") or root:IsA("TextButton") then
		into[#into + 1] = root
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			into[#into + 1] = d
		end
	end
end

local function plainText(text)
	if type(text) ~= "string" then
		return ""
	end
	return (text:gsub("<.->", ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function menuNameMatch(text, plr)
	local plain = plainText(text)
	if plain == "" or not plr then
		return false
	end
	local function hit(name)
		if not name or name == "" then
			return false
		end
		if plain == name or plain == "@" .. name then
			return true
		end
		if plain:sub(1, #name) == name then
			local rest = plain:sub(#name + 1)
			if #rest <= 6 and not rest:find("[%a%d]") then
				return true
			end
		end
		if plain:sub(1, #name + 1) == "@" .. name then
			local rest = plain:sub(#name + 2)
			if #rest <= 6 and not rest:find("[%a%d]") then
				return true
			end
		end
		return false
	end
	local saved = origDisplay[plr]
	if hit(plr.Name) or hit(plr.DisplayName) or hit(saved) then
		return true
	end
	if plain == (plr.DisplayName .. " (@" .. plr.Name .. ")") or plain == (plr.Name .. " (@" .. plr.DisplayName .. ")") then
		return true
	end
	if saved and (plain == (saved .. " (@" .. plr.Name .. ")") or plain == (saved .. " @" .. plr.Name)) then
		return true
	end
	if plain == (plr.DisplayName .. " @" .. plr.Name) or plain == (plr.DisplayName .. "\n@" .. plr.Name) then
		return true
	end
	return false
end

local function rebuildSpoofWatch()
	table.clear(spoofWatch)
	if not CFG.usernameSpoof then
		return
	end
	local seen = {}
	local labels = {}
	local function consider(root)
		if root then
			collectText(root, labels)
		end
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		local c = plr.Character
		if c then
			local head = c:FindFirstChild("Head")
			if head then
				consider(head)
			end
			for _, d in ipairs(c:GetChildren()) do
				if d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
					consider(d)
				end
			end
		end
	end
	consider(LP:FindFirstChildOfClass("PlayerGui"))
	local robloxGui = CoreGui and CoreGui:FindFirstChild("RobloxGui")
	if robloxGui then
		local list = robloxGui:FindFirstChild("PlayerList") or robloxGui:FindFirstChild("PlayerList", true)
		consider(list)
	end
	for _, label in ipairs(labels) do
		if seen[label] or not label.Parent or (gui and label:IsDescendantOf(gui)) then
			continue
		end
		seen[label] = true
		local basis = spoofOriginal[label] or label.Text
		local plain = plainText(basis)
		if #plain < 2 or #plain > 48 then
			continue
		end
		local billboard = label:FindFirstAncestorWhichIsA("BillboardGui") or label:FindFirstAncestorWhichIsA("SurfaceGui")
		local inMenu = not billboard
		for _, plr in ipairs(Players:GetPlayers()) do
			local repl = desiredSpoof(plr)
			if repl == "" then
				continue
			end
			local hit
			if inMenu then
				hit = menuNameMatch(basis, plr) or menuNameMatch(label.Text, plr)
			else
				hit = labelMatches(basis, plr) or labelMatches(label.Text, plr)
			end
			if hit then
				spoofWatch[#spoofWatch + 1] = { label, plr, repl }
				break
			end
		end
	end
end

local function applySpoof()
	if not CFG.usernameSpoof then
		return
	end
	if CFG.spoofSelfName ~= "" and LP.DisplayName ~= CFG.spoofSelfName then
		pushDisplayName(LP, CFG.spoofSelfName)
		if hum and hum.DisplayName ~= CFG.spoofSelfName then
			pcall(function()
				hum.DisplayName = CFG.spoofSelfName
			end)
		end
	end
	if CFG.spoofEnemyName ~= "" then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP and plr.DisplayName ~= CFG.spoofEnemyName then
				pushDisplayName(plr, CFG.spoofEnemyName)
				local ch = plr.Character
				local h = ch and ch:FindFirstChildOfClass("Humanoid")
				if h and h.DisplayName ~= CFG.spoofEnemyName then
					pcall(function()
						h.DisplayName = CFG.spoofEnemyName
					end)
				end
			end
		end
	end
	if tick() - spoofScanAt > 1.25 then
		spoofScanAt = tick()
		rebuildSpoofWatch()
	end
	for i = #spoofWatch, 1, -1 do
		local item = spoofWatch[i]
		if not item[1].Parent then
			table.remove(spoofWatch, i)
		else
			paintSpoofLabel(item[1], item[2], item[3])
		end
	end
end

