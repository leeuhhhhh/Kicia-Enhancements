local function coerceAimbotMode()
	local function oneOf(v, options, fallback)
		if table.find(options, v) then
			return v
		end
		return fallback
	end
	CFG.aimbotMode = oneOf(CFG.aimbotMode, { "Hold", "Toggle" }, "Hold")
	CFG.aimbotStyle = oneOf(CFG.aimbotStyle, { "Linear", "Spring", "Lock" }, "Linear")
	CFG.aimPoint = oneOf(CFG.aimPoint, { "Head", "Torso" }, "Head")
	CFG.triggerMode = oneOf(CFG.triggerMode, { "Hold", "Toggle", "Always" }, "Hold")
	CFG.espType = oneOf(CFG.espType, { "2D", "Corner", "3D" }, "2D")
	CFG.espNameMode = oneOf(CFG.espNameMode, { "Display", "Username" }, "Display")
	CFG.espHealthMode = oneOf(CFG.espHealthMode, { "Bar", "Text" }, "Bar")
	if not EMOTES_BY_NAME[CFG.customAnimName] then
		CFG.customAnimName = EMOTE_NAMES[1]
	end
	if type(CFG.spoofSelfName) ~= "string" then
		CFG.spoofSelfName = ""
	end
	if type(CFG.spoofEnemyName) ~= "string" then
		CFG.spoofEnemyName = ""
	end
	CFG.animSpeed = math.clamp(tonumber(CFG.animSpeed) or 1, 0.25, 10)
	CFG.doubleJumpMult = math.clamp(tonumber(CFG.doubleJumpMult) or 1, 1, 10)
	CFG.slideMult = math.clamp(tonumber(CFG.slideMult) or 1, 1, 10)
	CFG.fovRadius = math.clamp(tonumber(CFG.fovRadius) or 347, 20, 800)
	CFG.smoothing = math.clamp(tonumber(CFG.smoothing) or 100, 1, 100)
	if type(CFG.infDoubleJump) ~= "boolean" then
		CFG.infDoubleJump = false
	end
end

local function packWhitelist()
	local data = {}
	for uid, label in pairs(whitelist) do
		data[tostring(uid)] = tostring(label)
	end
	return data
end

local function applyWhitelistData(data)
	if type(data) ~= "table" then
		return
	end
	table.clear(whitelist)
	for uid, label in pairs(data) do
		local n = tonumber(uid)
		if n then
			whitelist[n] = tostring(label)
		end
	end
end

local function applyConfigData(data)
	if type(data) ~= "table" then
		return false
	end
	local src = data.cfg or data
	for k, v in pairs(src) do
		if CFG[k] ~= nil and not SKIP_CFG[k] and type(v) ~= "table" then
			if k == "aimbotBind" or k == "triggerBind" then
				local name = cleanKeyName(tostring(v))
				if name then
					CFG[k] = name
				end
			elseif k == "priorityUserId" then
				CFG[k] = tonumber(v)
			elseif type(CFG[k]) == "number" then
				CFG[k] = tonumber(v) or CFG[k]
			elseif type(CFG[k]) == "boolean" then
				if type(v) == "boolean" then
					CFG[k] = v
				end
			else
				CFG[k] = v
			end
		end
	end
	CFG.aimbotHeld = false
	CFG.triggerHeld = false
	if type(data.whitelist) == "table" then
		applyWhitelistData(data.whitelist)
	end
	coerceAimbotMode()
	return true
end

