on(RunService.RenderStepped, function()
	if killed then
		return
	end
	Camera = workspace.CurrentCamera
	if not Camera then
		return
	end
	local center = Camera.ViewportSize / 2
	if aimCircle then
		aimCircle.Position = center
		aimCircle.Radius = CFG.fovRadius
		aimCircle.Color = THEME.accent.c
		aimCircle.Visible = CFG.fovOn and not uiOpen
	end

	if selfAlive() and featureOn(CFG.aimbot, CFG.aimbotMode, CFG.aimbotHeld) then
		local now = tick()
		local pointMode = CFG.aimbotStyle == "Lock" and "Head" or CFG.aimPoint
		local part = pickTarget(CFG.fovRadius, pointMode, CFG.visibleCheck)
		if part then
			if CFG.aimbotStyle == "Lock" then
				currentLockPart = part
				potentialTarget = part
				potentialEnterTime = now
			else
				if potentialTarget ~= part then
					potentialTarget = part
					potentialEnterTime = now
				end
				if (now - potentialEnterTime) * 1000 >= CFG.switchDelay then
					currentLockPart = part
				else
					currentLockPart = nil
				end
			end
		elseif CFG.aimbotStyle == "Lock" and currentLockPart and currentLockPart.Parent then
			local model = currentLockPart:FindFirstAncestorOfClass("Model")
			local plr = model and Players:GetPlayerFromCharacter(model)
			local head = model and (model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart"))
			if plr and alive(plr) and not skipped(plr) and head then
				currentLockPart = head
			else
				currentLockPart = nil
			end
		else
			potentialTarget = nil
			currentLockPart = nil
		end
		if CFG.aimbotStyle ~= "Lock" and currentLockPart and currentLockPart.Parent then
			local v, onScreen = Camera:WorldToViewportPoint(currentLockPart.Position)
			if onScreen and v.Z > 0 then
				local dx, dy = v.X - center.X, v.Y - center.Y
				if CFG.aimbotStyle == "Spring" then
					if springStart == 0 then
						springStart = now
					end
					local t = 0.04 + (math.clamp(CFG.smoothing / 100, 0.04, 1) - 0.04) * math.clamp((now - springStart) / 0.8, 0, 1)
					moveMouse(dx * t, dy * t)
				else
					local t = math.clamp(CFG.smoothing / 100, 0.04, 1)
					moveMouse(dx * t, dy * t)
				end
			end
		elseif CFG.aimbotStyle ~= "Lock" then
			currentLockPart = nil
			springStart = 0
		end
	else
		currentLockPart = nil
		potentialTarget = nil
		springStart = 0
	end

	if selfAlive() and featureOn(CFG.trigger, CFG.triggerMode, CFG.triggerHeld) then
		trigParams.FilterDescendantsInstances = { char }
		local ray = Camera:ViewportPointToRay(center.X, center.Y)
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 800, trigParams)
		local okHit = false
		if hit and hit.Instance then
			local model = hit.Instance:FindFirstAncestorOfClass("Model")
			local plr = model and Players:GetPlayerFromCharacter(model)
			if plr and alive(plr) and not skipped(plr) and is35Visible(model) then
				okHit = true
			end
		end
		if okHit then
			if triggerDetectTime == 0 then
				triggerDetectTime = tick()
			end
			if (tick() - triggerDetectTime) * 1000 >= CFG.triggerDelay then
				clickMouse()
			end
		else
			triggerDetectTime = 0
		end
	else
		triggerDetectTime = 0
	end

	local seen = {}
	local espOn = HAS_DRAW and (CFG.espBox or CFG.espFill or CFG.espName or CFG.espDistance or CFG.espHealth)
	local function asciiName(s)
		if type(s) ~= "string" or s == "" then
			return nil
		end
		for i = 1, #s do
			local b = string.byte(s, i)
			if b < 32 or b > 126 then
				return nil
			end
		end
		return s
	end
	if espOn then
		local accent = THEME.accent.c
		local font = THEME.font.c
		for _, plr in ipairs(Players:GetPlayers()) do
			if not skipped(plr) and alive(plr) then
				local c = plr.Character
				local h = c:FindFirstChildOfClass("Humanoid")
				local r = c:FindFirstChild("HumanoidRootPart")
				local head = c:FindFirstChild("Head")
				if not (CFG.healthCheck and h and h.Health < 0.1) and r then
					seen[plr.UserId] = true
					local p = ensurePool(plr.UserId)
					local topPos = head and (head.Position + Vector3.new(0, 0.4, 0)) or (r.Position + Vector3.new(0, 2.6, 0))
					local botPos = r.Position - Vector3.new(0, 3, 0)
					local tv, onScreen = Camera:WorldToViewportPoint(topPos)
					local bv = Camera:WorldToViewportPoint(botPos)
					if onScreen and tv.Z > 0 then
						local height = math.abs(tv.Y - bv.Y)
						local width = height * 0.55
						local x, y = tv.X - width / 2, tv.Y
						if p.fill then
							p.fill.Visible = CFG.espFill
							if CFG.espFill then
								p.fill.Position = Vector2.new(x, y)
								p.fill.Size = Vector2.new(width, height)
								p.fill.Color = accent
							end
						end
						if p.box then
							p.box.Visible = CFG.espBox and CFG.espType == "2D"
							if p.box.Visible then
								p.box.Position = Vector2.new(x, y)
								p.box.Size = Vector2.new(width, height)
								p.box.Color = accent
							end
						end
						for _, o in ipairs(p.corners) do o.Visible = false end
						if CFG.espBox and CFG.espType == "Corner" then
							local L = math.clamp(width * 0.22, 5, 16)
							local pts = {
								{ Vector2.new(x, y), Vector2.new(x + L, y) },
								{ Vector2.new(x, y), Vector2.new(x, y + L) },
								{ Vector2.new(x + width, y), Vector2.new(x + width - L, y) },
								{ Vector2.new(x + width, y), Vector2.new(x + width, y + L) },
								{ Vector2.new(x, y + height), Vector2.new(x + L, y + height) },
								{ Vector2.new(x, y + height), Vector2.new(x, y + height - L) },
								{ Vector2.new(x + width, y + height), Vector2.new(x + width - L, y + height) },
								{ Vector2.new(x + width, y + height), Vector2.new(x + width, y + height - L) },
							}
							for n, pair in ipairs(pts) do
								line(p.corners[n], pair[1], pair[2], accent)
							end
						end
						for _, o in ipairs(p.edges) do o.Visible = false end
						if CFG.espBox and CFG.espType == "3D" then
							local cf = r.CFrame
							local s3 = Vector3.new(2, 3, 1.1)
							local corners3, idx = {}, 1
							for _, sx in ipairs({ -1, 1 }) do
								for _, sy in ipairs({ -1, 1 }) do
									for _, sz in ipairs({ -1, 1 }) do
										corners3[idx] = (cf * CFrame.new(sx * s3.X, sy * s3.Y, sz * s3.Z)).Position
										idx += 1
									end
								end
							end
							local function sp(i)
								local vv = Camera:WorldToViewportPoint(corners3[i])
								return Vector2.new(vv.X, vv.Y), vv.Z > 0
							end
							local pairsIdx = { { 1, 2 }, { 3, 4 }, { 5, 6 }, { 7, 8 }, { 1, 3 }, { 2, 4 }, { 5, 7 }, { 6, 8 }, { 1, 5 }, { 2, 6 }, { 3, 7 }, { 4, 8 } }
							for n, pr in ipairs(pairsIdx) do
								local a, oa = sp(pr[1])
								local b, ob = sp(pr[2])
								if oa and ob then
									line(p.edges[n], a, b, accent)
								end
							end
						end
						if p.name then
							p.name.Visible = CFG.espName
							if CFG.espName then
								local shown
								if CFG.usernameSpoof and CFG.spoofEnemyName ~= "" then
									shown = asciiName(CFG.spoofEnemyName)
								elseif CFG.espNameMode == "Username" then
									shown = asciiName(plr.Name)
								else
									shown = asciiName(plr.DisplayName) or asciiName(plr.Name)
								end
								p.name.Text = shown or "Player"
								p.name.Position = Vector2.new(tv.X, y - 18)
								p.name.Color = font
							end
						end
						if p.dist and hrp then
							p.dist.Visible = CFG.espDistance
							if CFG.espDistance then
								p.dist.Text = tostring(math.floor((r.Position - hrp.Position).Magnitude + 0.5)) .. "m"
								p.dist.Position = Vector2.new(tv.X, y + height + 3)
								p.dist.Color = font
							end
						end
						if CFG.espHealth and h then
							local ratio = math.clamp(h.Health / math.max(h.MaxHealth, 1), 0, 1)
							if CFG.espHealthMode == "Bar" then
								if p.hpBg then
									p.hpBg.Visible = true
									p.hpBg.Position = Vector2.new(x - 6, y)
									p.hpBg.Size = Vector2.new(3, height)
								end
								if p.hp then
									p.hp.Visible = true
									p.hp.Size = Vector2.new(3, height * ratio)
									p.hp.Position = Vector2.new(x - 6, y + height * (1 - ratio))
								end
								if p.hpTx then p.hpTx.Visible = false end
							else
								if p.hpTx then
									p.hpTx.Visible = true
									p.hpTx.Text = tostring(math.floor(h.Health))
									p.hpTx.Position = Vector2.new(x + width + 5, y)
									p.hpTx.Color = Color3.fromRGB(90, 220, 120)
								end
								if p.hpBg then p.hpBg.Visible = false end
								if p.hp then p.hp.Visible = false end
							end
						else
							if p.hpBg then p.hpBg.Visible = false end
							if p.hp then p.hp.Visible = false end
							if p.hpTx then p.hpTx.Visible = false end
						end
					else
						hidePool(p)
					end
				end
			end
		end
	end
	for uid, p in pairs(pool) do
		if not seen[uid] then
			hidePool(p)
		end
	end
end)

local ghostModel, ghostHum, ghostWalk
local ghostPos
local ghostLook = Vector3.new(0, 0, -1)
local ghostYVel = 0
local ghostGrounded = true
local ghostAirJumps = 0
local ghostSpacePrev = false
local ghosting = false
local lastSafePos
local ghostParams = RaycastParams.new()
ghostParams.FilterType = Enum.RaycastFilterType.Exclude

local function rageBodyActive()
	return CFG.voidActive or CFG.orbitActive or CFG.translocate or CFG.evasionActive
end

local function hideRealBody(hidden)
	if not char then
		return
	end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
			d.LocalTransparencyModifier = hidden and 1 or 0
		end
	end
end

function clearGhost(snapBack)
	if snapBack and hrp and ghostPos then
		local face = ghostLook.Magnitude > 0.1 and ghostLook.Unit or Vector3.new(0, 0, -1)
		hrp.CFrame = CFrame.lookAt(ghostPos, ghostPos + face)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
	hideRealBody(false)
	if ghostWalk then
		pcall(function()
			ghostWalk:Stop()
		end)
		ghostWalk = nil
	end
	if ghostModel then
		ghostModel:Destroy()
		ghostModel = nil
	end
	ghostHum = nil
	ghosting = false
	ghostYVel = 0
	ghostGrounded = true
	ghostAirJumps = 0
end

local function buildGhost()
	if ghostModel then
		ghostModel:Destroy()
		ghostModel = nil
		ghostHum = nil
	end
	if ghostWalk then
		pcall(function()
			ghostWalk:Stop()
		end)
		ghostWalk = nil
	end
	if not char or not hrp then
		return false
	end
	local clone
	pcall(function()
		local prev = char.Archivable
		char.Archivable = true
		clone = char:Clone()
		char.Archivable = prev
	end)
	if not clone then
		clone = Instance.new("Model")
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
				pcall(function()
					local was = d.Archivable
					d.Archivable = true
					local copy = d:Clone()
					d.Archivable = was
					if copy then
						if copy:IsA("BasePart") then
							copy.Anchored = true
							copy.CanCollide = false
							copy.CanTouch = false
							copy.CanQuery = false
							copy.Massless = true
						end
						copy.Parent = clone
					end
				end)
			end
		end
		local humCopy = Instance.new("Humanoid")
		humCopy.Name = "Humanoid"
		humCopy.Parent = clone
	end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
			d:Destroy()
		end
	end
	local ghum = clone:FindFirstChildOfClass("Humanoid")
	local ghrp = clone:FindFirstChild("HumanoidRootPart")
	if not ghum or not ghrp then
		clone:Destroy()
		return false
	end
	ghum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	ghum.PlatformStand = true
	pcall(function()
		ghum.EvaluateStateMachine = false
	end)
	for _, p in ipairs(clone:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = false
			p.Massless = true
		end
	end
	clone.PrimaryPart = ghrp
	pcall(function()
		clone.WorldPivot = ghrp.CFrame
	end)
	clone.Name = "KE_View"
	clone.Parent = workspace
	ghostModel = clone
	ghostHum = ghum
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://507777826"
	pcall(function()
		local track = ghum:LoadAnimation(anim)
		track.Looped = true
		track.Priority = Enum.AnimationPriority.Movement
		track:Play()
		track:AdjustSpeed(0)
		ghostWalk = track
	end)
	return true
end

local function stepGhost(dt)
	dt = math.clamp(dt, 1 / 240, 1 / 20)
	local cam = workspace.CurrentCamera
	local look = cam and cam.CFrame.LookVector or ghostLook
	local right = cam and cam.CFrame.RightVector or Vector3.new(1, 0, 0)
	local flatLook = Vector3.new(look.X, 0, look.Z)
	local flatRight = Vector3.new(right.X, 0, right.Z)
	if flatLook.Magnitude > 0.05 then
		flatLook = flatLook.Unit
	else
		flatLook = ghostLook
	end
	if flatRight.Magnitude > 0.05 then
		flatRight = flatRight.Unit
	else
		flatRight = Vector3.new(1, 0, 0)
	end
	local wish = Vector3.zero
	local md = hum and hum.MoveDirection or Vector3.zero
	if md.Magnitude > 0.08 then
		wish = Vector3.new(md.X, 0, md.Z)
	else
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then wish += flatLook end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then wish -= flatLook end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then wish -= flatRight end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then wish += flatRight end
	end
	local speed = 16
	if CFG.speedwalk then
		speed = CFG.speedValue
	elseif hum and hum.WalkSpeed > 0 then
		speed = hum.WalkSpeed
	end
	if slideHeld and CFG.slideMult > 1 then
		speed = speed * CFG.slideMult
	end
	local horiz = Vector3.zero
	if wish.Magnitude > 0.05 then
		horiz = wish.Unit * speed
		ghostLook = Vector3.new(horiz.X, 0, horiz.Z).Unit
	end
	local space = UserInputService:IsKeyDown(Enum.KeyCode.Space)
	if CFG.flight then
		local vy = 0
		if space then vy = CFG.flightSpeed end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vy = -CFG.flightSpeed end
		ghostPos = ghostPos + Vector3.new(horiz.X, vy, horiz.Z) * dt
		ghostYVel = 0
		ghostGrounded = false
	else
		if space and not ghostSpacePrev then
			if ghostGrounded then
				ghostYVel = jumpVelocity() * math.max(CFG.doubleJumpMult, 1)
				ghostGrounded = false
				ghostAirJumps = 0
			elseif CFG.infDoubleJump or CFG.doubleJumpMult > 1 then
				ghostAirJumps += 1
				ghostYVel = jumpVelocity() * CFG.doubleJumpMult
			end
		end
		ghostYVel = math.max(-180, ghostYVel - workspace.Gravity * dt)
		ghostParams.FilterDescendantsInstances = { char, ghostModel }
		local nextPos = ghostPos + Vector3.new(horiz.X * dt, 0, horiz.Z * dt)
		if horiz.Magnitude > 0 then
			local wall = workspace:Raycast(ghostPos + Vector3.new(0, 1.5, 0), Vector3.new(horiz.X, 0, horiz.Z).Unit * (horiz.Magnitude * dt + 1.5), ghostParams)
			if wall then
				nextPos = Vector3.new(ghostPos.X, ghostPos.Y, ghostPos.Z)
			end
		end
		nextPos = nextPos + Vector3.new(0, ghostYVel * dt, 0)
		local stand = 3
		if ghostHum and ghostModel then
			local ghrp = ghostModel:FindFirstChild("HumanoidRootPart")
			stand = (ghostHum.HipHeight or 2) + ((ghrp and ghrp.Size.Y or 2) * 0.5)
		end
		local floorHit = workspace:Raycast(Vector3.new(nextPos.X, math.max(ghostPos.Y, nextPos.Y) + 2, nextPos.Z), Vector3.new(0, -8 - math.abs(ghostYVel * dt), 0), ghostParams)
		if floorHit and ghostYVel <= 0 and nextPos.Y <= floorHit.Position.Y + stand then
			nextPos = Vector3.new(nextPos.X, floorHit.Position.Y + stand, nextPos.Z)
			ghostYVel = 0
			ghostGrounded = true
			ghostAirJumps = 0
		else
			ghostGrounded = false
		end
		ghostPos = nextPos
	end
	ghostSpacePrev = space
	if ghostModel then
		local face = ghostLook.Magnitude > 0.1 and ghostLook.Unit or flatLook
		ghostModel:PivotTo(CFrame.lookAt(ghostPos, ghostPos + face))
		local head = ghostModel:FindFirstChild("Head")
		if head and cam and (cam.CFrame.Position - head.Position).Magnitude < 1.4 then
			head.LocalTransparencyModifier = 1
		elseif head then
			head.LocalTransparencyModifier = 0
		end
		local track = ghostWalk
		if track then
			pcall(function()
				track:AdjustSpeed(horiz.Magnitude > 1 and math.clamp(speed / 16, 0.4, 2.4) or 0)
			end)
		end
	end
end

RunService:BindToRenderStep("KE_GhostCam", Enum.RenderPriority.Last.Value + 100, function(dt)
	if killed then
		if ghosting then
			clearGhost(false)
		end
		return
	end
	local cam = workspace.CurrentCamera
	local want = CFG.rageSilent and rageBodyActive() and selfAlive() and hrp and cam
	if want then
		if ghosting and (not ghostModel or not ghostModel.Parent) then
			ghosting = false
		end
		if not ghosting then
			ghostPos = lastSafePos or hrp.Position
			ghostLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
			if ghostLook.Magnitude < 0.1 then
				ghostLook = Vector3.new(0, 0, -1)
			else
				ghostLook = ghostLook.Unit
			end
			ghostYVel = 0
			ghostGrounded = true
			buildGhost()
			ghosting = true
		end
		hideRealBody(true)
		stepGhost(dt)
		local delta = ghostPos - hrp.Position
		if delta.Magnitude > 1 then
			local camPos = cam.CFrame.Position
			if (camPos - hrp.Position).Magnitude < (camPos - ghostPos).Magnitude then
				local goal = cam.CFrame + delta
				local old = cam.CFrame
				local function shift(inst)
					local ok, pivot = pcall(function()
						return inst:GetPivot()
					end)
					if ok then
						pcall(function()
							inst:PivotTo(goal * old:ToObjectSpace(pivot))
						end)
					end
				end
				for _, child in ipairs(cam:GetChildren()) do
					if child:IsA("Model") or child:IsA("BasePart") then
						shift(child)
					elseif child:IsA("Folder") then
						for _, sub in ipairs(child:GetChildren()) do
							if sub:IsA("Model") or sub:IsA("BasePart") then
								shift(sub)
							end
						end
					end
				end
				cam.CFrame = goal
			end
		end
	else
		if ghosting then
			clearGhost(true)
		elseif hrp and selfAlive() and not rageBodyActive() then
			lastSafePos = hrp.Position
		end
	end
end)

local function setOpen(v)
	uiOpen = v
	if v then
		shell.Visible = true
		task.defer(syncCards)
		task.delay(0.05, syncCards)
		local ml = UserInputService:GetMouseLocation()
		noteSidebarHover(ml)
	else
		closePicker()
		closeDrop()
		hoverSide = false
		hoverGen += 1
		setSidebar(false, true)
		shell.Visible = false
	end
end

on(UserInputService.InputBegan, function(input, gp)
	if killed then
		return
	end
	if listening then
		return
	end
	if matchBind(input, PREFS.menuKey) and input.UserInputType == Enum.UserInputType.Keyboard then
		setOpen(not uiOpen)
		return
	end
	if isSlideKey(input) then
		slideHeld = true
		slideBase = nil
	end
	if gp then
		return
	end
	if matchBind(input, CFG.aimbotBind) then
		if CFG.aimbotMode == "Hold" then
			CFG.aimbotHeld = true
		elseif CFG.aimbotMode == "Toggle" then
			CFG.aimbot = not CFG.aimbot
			repaint()
		end
	end
	if matchBind(input, CFG.triggerBind) then
		if CFG.triggerMode == "Hold" then
			CFG.triggerHeld = true
		elseif CFG.triggerMode == "Toggle" then
			CFG.trigger = not CFG.trigger
			repaint()
		end
	end
end)

on(UserInputService.JumpRequest, function()
	if killed or not selfAlive() or not hum or not hrp then
		return
	end
	if hum.FloorMaterial ~= Enum.Material.Air then
		airJumps = 0
		return
	end
	airJumps += 1
	local extra = airJumps > 1
	if extra and not CFG.infDoubleJump then
		return
	end
	if (not extra) and CFG.doubleJumpMult <= 1 then
		return
	end
	local y = jumpVelocity() * CFG.doubleJumpMult
	task.defer(function()
		if not hrp or not selfAlive() then
			return
		end
		local v = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = Vector3.new(v.X, y, v.Z)
	end)
end)

on(UserInputService.InputEnded, function(input)
	if matchBind(input, CFG.aimbotBind) then
		CFG.aimbotHeld = false
	end
	if matchBind(input, CFG.triggerBind) then
		CFG.triggerHeld = false
	end
	if isSlideKey(input) then
		slideHeld = false
		slideBase = nil
	end
end)

local lockCamType = nil
local function shiftCamModels(cam, newCF)
	local old = cam.CFrame
	local function shift(inst)
		local ok, pivot = pcall(function()
			return inst:GetPivot()
		end)
		if not ok then
			return
		end
		local rel = old:ToObjectSpace(pivot)
		pcall(function()
			inst:PivotTo(newCF * rel)
		end)
	end
	for _, child in ipairs(cam:GetChildren()) do
		if child:IsA("Model") then
			shift(child)
		elseif child:IsA("Folder") then
			for _, sub in ipairs(child:GetChildren()) do
				if sub:IsA("Model") then
					shift(sub)
				end
			end
		end
	end
end
RunService:BindToRenderStep("KE_AimLock", Enum.RenderPriority.Last.Value, function()
	local cam = workspace.CurrentCamera
	local part = currentLockPart
	local locking = (not killed) and (not ghosting) and CFG.aimbotStyle == "Lock" and selfAlive() and featureOn(CFG.aimbot, CFG.aimbotMode, CFG.aimbotHeld) and cam and part and part.Parent
	if lockCamType and cam and cam.CameraType == Enum.CameraType.Scriptable then
		pcall(function()
			cam.CameraType = lockCamType
		end)
		lockCamType = nil
	end
	if not locking then
		return
	end
	local origin = cam.CFrame.Position
	local goal = CFrame.new(origin, part.Position)
	shiftCamModels(cam, goal)
	cam.CFrame = goal
end)

