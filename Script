refreshActive = function()
	activeFrame.Visible = PREFS.activeMenu
	if not PREFS.activeMenu then
		return
	end
	local lines = {}
	if not selfAlive() then
		lines[1] = "Inactive until respawn"
		if CFG.usernameSpoof then
			lines[#lines + 1] = "Username Spoof"
		end
	else
		if featureOn(CFG.aimbot, CFG.aimbotMode, CFG.aimbotHeld) then
			lines[#lines + 1] = string.format("[%s] Aimbot (%s)", prettyKey(CFG.aimbotBind), CFG.aimbotMode)
		end
		if featureOn(CFG.trigger, CFG.triggerMode, CFG.triggerHeld) then
			lines[#lines + 1] = string.format("[%s] Triggerbot (%s)", prettyKey(CFG.triggerBind), CFG.triggerMode)
		end
		if CFG.voidActive then lines[#lines + 1] = "Void Spam" end
		if CFG.orbitActive then lines[#lines + 1] = "Player Orbit" end
		if CFG.translocate then lines[#lines + 1] = "Translocate" end
		if CFG.evasionActive then lines[#lines + 1] = "Evasion" end
		if CFG.rageSilent then lines[#lines + 1] = "Silent Rage" end
		if CFG.noclip then lines[#lines + 1] = "Noclip" end
		if CFG.speedwalk then lines[#lines + 1] = "Speedwalk" end
		if CFG.flight then lines[#lines + 1] = "Flight" end
		if CFG.antiAim then lines[#lines + 1] = "Anti Aim" end
		if CFG.worldEnabled then lines[#lines + 1] = "World" end
		if CFG.infDoubleJump then lines[#lines + 1] = "Infinite Double Jump" end
		if CFG.doubleJumpMult > 1 then lines[#lines + 1] = string.format("Double Jump %.2gx", CFG.doubleJumpMult) end
		if CFG.slideMult > 1 then lines[#lines + 1] = string.format("Slide %.2gx", CFG.slideMult) end
		if CFG.customAnimEnabled then lines[#lines + 1] = "Emote: " .. CFG.customAnimName end
		if CFG.usernameSpoof then lines[#lines + 1] = "Username Spoof" end
		if #lines == 0 then
			lines[1] = "None active"
		end
	end
	local sig = table.concat(lines, "|")
	if sig == activeSig then
		return
	end
	activeSig = sig
	for _, c in ipairs(activeList:GetChildren()) do
		if c:IsA("TextLabel") then
			c:Destroy()
		end
	end
	for i, line in ipairs(lines) do
		local l = textOf(activeList, line, (line == "None active" or line == "Inactive until respawn") and "muted" or "font", 12, false)
		l.Size = UDim2.new(1, 0, 0, 16)
		l.LayoutOrder = i
		l.ZIndex = 182
	end
	paintRoles()
end

