local function applyUiFont()
	if not gui then
		return
	end
	local font = uiFontEnum()
	local weight = (PREFS.uiBold and Enum.FontWeight.Bold) or Enum.FontWeight.Regular
	local style = (PREFS.uiItalic and Enum.FontStyle.Italic) or Enum.FontStyle.Normal
	local scale = math.clamp(tonumber(PREFS.uiSize) or 13, 11, 18) / 13
	for _, d in ipairs(gui:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
			if not d:FindFirstAncestor("Icon") and d.Name ~= "LogoText" then
				if d:GetAttribute("KEBase") == nil then
					d:SetAttribute("KEBase", d.TextSize)
				end
				local base = tonumber(d:GetAttribute("KEBase")) or 13
				d.TextSize = math.clamp(math.floor(base * scale + 0.5), 9, 28)
				local applied = false
				pcall(function()
					local face = Font.fromEnum(font)
					d.FontFace = Font.new(face.Family, weight, style)
					applied = true
				end)
				if not applied then
					d.Font = font
				end
			end
		end
	end
end

