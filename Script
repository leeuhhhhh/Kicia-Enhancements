local function iconTint()
	local main = THEME.main.c
	local bg = THEME.background.c
	local function lum(c)
		return c.R * 0.299 + c.G * 0.587 + c.B * 0.114
	end
	local c = main
	if lum(c) < 0.55 then
		c = main:Lerp(Color3.new(1, 1, 1), 0.72)
	end
	local diff = math.abs(c.R - bg.R) + math.abs(c.G - bg.G) + math.abs(c.B - bg.B)
	if diff < 0.22 then
		return THEME.font.c
	end
	return c
end

local function paintRoles()
	local fontC = THEME.font.c
	local mutedC = fontC:Lerp(THEME.background.c, 0.42)
	local icons = iconTint()
	local map = {
		background = THEME.background,
		main = THEME.main,
		outline = THEME.outline,
		font = THEME.font,
		accent = THEME.accent,
	}
	local aliveReg = {}
	for _, item in ipairs(registry) do
		local obj = item.obj
		if obj and obj.Parent then
			aliveReg[#aliveReg + 1] = item
			local role = item.role
			if item.kind == "text" then
				local c, t
				if role == "icon" then
					c, t = icons, 0
				elseif role == "muted" then
					c, t = mutedC, 0
				elseif role == "danger" then
					c, t = FIXED.danger, 0
				elseif role == "success" then
					c, t = FIXED.success, 0
				elseif role == "warning" then
					c, t = FIXED.warning, 0
				elseif map[role] then
					c, t = map[role].c, map[role].t
				else
					c, t = fontC, 0
				end
				obj.TextColor3 = c
				obj.TextTransparency = t
			elseif item.kind == "bg" then
				local e = map[role] or THEME.main
				if role == "danger" then
					obj.BackgroundColor3 = FIXED.danger
					obj.BackgroundTransparency = 0
				elseif role == "success" then
					obj.BackgroundColor3 = FIXED.success
					obj.BackgroundTransparency = 0
				else
					obj.BackgroundColor3 = e.c
					obj.BackgroundTransparency = e.t
				end
			elseif item.kind == "stroke" then
				obj.Color = THEME.outline.c
				obj.Transparency = math.clamp(THEME.outline.t, 0, 0.85)
			elseif item.kind == "image" then
				obj.ImageColor3 = THEME.accent.c
				obj.ImageTransparency = THEME.accent.t
			end
		end
	end
	registry = aliveReg
	applyUiFont()
end

local function repaint()
	paintRoles()
	for _, fn in ipairs(refreshers) do
		fn()
	end
end

