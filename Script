local function applyNoclip(state)
	if not char then
		return
	end
	if state then
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then
				if collideState[p] == nil then
					collideState[p] = p.CanCollide
				end
				p.CanCollide = false
			end
		end
	else
		for p, prev in pairs(collideState) do
			if typeof(p) == "Instance" and p.Parent then
				p.CanCollide = prev
			end
		end
		collideState = {}
	end
end

local function stopAnim()
	if emoteTrack then
		pcall(function()
			emoteTrack:Stop(0.05)
			emoteTrack:Destroy()
		end)
		emoteTrack = nil
	end
	if emoteAnim then
		pcall(function()
			emoteAnim:Destroy()
		end)
		emoteAnim = nil
	end
end

local function pullAnimId(inst, depth)
	if depth > 5 or typeof(inst) ~= "Instance" then
		return nil
	end
	if inst:IsA("Animation") then
		local id = inst.AnimationId
		if type(id) == "string" and id ~= "" and id ~= "rbxassetid://0" then
			return id
		end
	end
	local ok, idProp = pcall(function()
		return inst.AnimationId
	end)
	if ok and type(idProp) == "string" and idProp:find("rbxassetid://", 1, true) and idProp ~= "rbxassetid://0" then
		return idProp
	end
	for _, child in ipairs(inst:GetChildren()) do
		local hit = pullAnimId(child, depth + 1)
		if hit then
			return hit
		end
	end
	return nil
end

local function resolveAnimId(id)
	local key = tostring(id)
	if resolvedAnims[key] then
		return resolvedAnims[key]
	end
	local direct = "rbxassetid://" .. key
	local found = direct
	local getter = game.GetObjects
	if type(getter) == "function" then
		local ok, objs = pcall(getter, game, direct)
		if ok and type(objs) == "table" then
			for _, obj in ipairs(objs) do
				if typeof(obj) == "Instance" then
					local hit = pullAnimId(obj, 0)
					pcall(function()
						obj:Destroy()
					end)
					if hit then
						found = hit
						break
					end
				end
			end
		end
	end
	resolvedAnims[key] = found
	return found
end

local function playSelectedAnim()
	if not hum or not char or hum.Health <= 0 then
		return
	end
	local id = EMOTES_BY_NAME[CFG.customAnimName]
	if not id then
		return
	end
	stopAnim()
	local ok = pcall(function()
		local anim = Instance.new("Animation")
		anim.Name = "KE_Emote"
		anim.AnimationId = resolveAnimId(id)
		anim.Parent = LP
		emoteAnim = anim
		emoteTrack = hum:LoadAnimation(anim)
		emoteTrack.Priority = Enum.AnimationPriority.Action4
		emoteTrack.Looped = true
		emoteTrack:Play(0.05, 1, CFG.animSpeed)
		emoteTrack:AdjustSpeed(CFG.animSpeed)
	end)
	if not ok then
		stopAnim()
	end
end

local emoteRetryAt = 0
local function keepEmote()
	if not CFG.customAnimEnabled or not hum or hum.Health <= 0 then
		return
	end
	local speed = CFG.animSpeed
	if emoteTrack then
		local ok, playing = pcall(function()
			return emoteTrack.IsPlaying
		end)
		if ok and playing then
			local curOk, cur = pcall(function()
				return emoteTrack.Speed
			end)
			if curOk and math.abs((cur or speed) - speed) > 0.03 then
				pcall(function()
					emoteTrack:AdjustSpeed(speed)
				end)
			end
			return
		end
		if tick() - emoteRetryAt < 0.45 then
			return
		end
		emoteRetryAt = tick()
		local resumed = pcall(function()
			emoteTrack.Priority = Enum.AnimationPriority.Action4
			emoteTrack.Looped = true
			emoteTrack:Play(0.05, 1, speed)
			emoteTrack:AdjustSpeed(speed)
		end)
		if resumed then
			return
		end
		emoteTrack = nil
	end
	if tick() - emoteRetryAt < 0.45 then
		return
	end
	emoteRetryAt = tick()
	playSelectedAnim()
end

