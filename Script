local function showPage(name, rebuild)
	if closeDrop then
		closeDrop()
	end
	currentPage = name
	for n, f in pairs(pages) do
		f.Visible = n == name
	end
	for n, b in pairs(navButtons) do
		local onPage = n == name
		b.BackgroundColor3 = THEME.main.c
		b.BackgroundTransparency = onPage and THEME.main.t or 1
		navNames[n].TextColor3 = onPage and THEME.accent.c or THEME.font.c:Lerp(THEME.background.c, 0.42)
		navNames[n].TextTransparency = 0
	end
	if rebuild then
		if name == "Ragebot" and rebuildPriority then
			rebuildPriority()
		elseif name == "Whitelist" and rebuildWhitelist then
			rebuildWhitelist()
		end
	end
	task.defer(syncCards)
end

local function iconPiece(parent, x, y, w, h, radius, strokeOnly)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.BackgroundTransparency = strokeOnly and 1 or 0
	f.ZIndex = 56
	f.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 1)
	c.Parent = f
	local stroke
	if strokeOnly then
		stroke = Instance.new("UIStroke")
		stroke.Thickness = 1.5
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = f
	end
	iconParts[#iconParts + 1] = { obj = f, stroke = stroke }
	return f
end

local function buildIcon(parent, kind)
	local holder = Instance.new("Frame")
	holder.Name = "Icon"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(22, 22)
	holder.AnchorPoint = Vector2.new(0, 0.5)
	holder.Position = UDim2.new(0, 8, 0.5, 0)
	holder.ZIndex = 56
	holder.Parent = parent
	local function bar(x, y, w, h, radius, rot)
		local f = iconPiece(holder, x, y, w, h, radius or 1, false)
		if rot then
			f.Rotation = rot
		end
		return f
	end
	local function outline(x, y, w, h, radius)
		return iconPiece(holder, x, y, w, h, radius, true)
	end
	local function glyph(str)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(1, 1)
		l.Font = Enum.Font.GothamBold
		l.TextSize = 12
		l.TextXAlignment = Enum.TextXAlignment.Center
		l.TextYAlignment = Enum.TextYAlignment.Center
		l.Text = str
		l.ZIndex = 57
		l.Parent = holder
		iconParts[#iconParts + 1] = { obj = l, text = true }
		return l
	end
	if kind == "combat" then
		bar(7, 15, 5, 8, 1)
		bar(12, 10, 14, 5, 1)
		bar(16, 7, 8, 3, 1)
	elseif kind == "rage" then
		outline(11, 13, 13, 11, 3)
		bar(11, 5, 2, 4, 1)
		bar(8, 13, 3, 3, 2)
		bar(14, 13, 3, 3, 2)
	elseif kind == "esp" then
		outline(11, 11, 16, 9, 5)
		bar(11, 11, 4, 4, 2)
	elseif kind == "player" then
		bar(8, 7, 5, 5, 3)
		bar(8, 15, 8, 5, 2)
		bar(15, 9, 4, 4, 2)
		bar(15, 16, 6, 4, 2)
	elseif kind == "world" then
		outline(11, 11, 15, 15, 8)
		bar(11, 8, 9, 2, 1)
		bar(11, 11, 13, 2, 1)
		bar(11, 14, 9, 2, 1)
	elseif kind == "spoof" then
		outline(11, 12, 14, 11, 5)
		bar(8, 12, 3, 3, 2)
		bar(14, 12, 3, 3, 2)
	elseif kind == "check" then
		glyph("✓")
	elseif kind == "keys" then
		outline(11, 11, 14, 14, 3)
		glyph("F")
	else
		bar(11, 6, 13, 2, 1)
		bar(11, 11, 13, 2, 1)
		bar(11, 16, 13, 2, 1)
		bar(6, 6, 4, 4, 2)
		bar(15, 11, 4, 4, 2)
		bar(9, 16, 4, 4, 2)
	end
	return holder
end

