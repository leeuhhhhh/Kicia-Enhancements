local function makeSlider(parent, order, label, minV, maxV, get, set, suffix, step)
	local wrap = Instance.new("Frame")
	wrap.BackgroundTransparency = 1
	wrap.Size = UDim2.new(1, 0, 0, 34)
	wrap.LayoutOrder = order()
	wrap.ZIndex = 56
	wrap.Parent = parent
	local lab = textOf(wrap, label, "muted", 12, false)
	lab.Size = UDim2.new(0.62, 0, 0, 14)
	lab.ZIndex = 57
	local val = textOf(wrap, "", "font", 12, false)
	val.Size = UDim2.new(0.38, 0, 0, 14)
	val.Position = UDim2.new(0.62, 0, 0, 0)
	val.TextXAlignment = Enum.TextXAlignment.Right
	val.ZIndex = 57
	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 0, 6)
	bar.Position = UDim2.fromOffset(0, 20)
	bar.BorderSizePixel = 0
	bar.ZIndex = 57
	bar.Parent = wrap
	track(bar, "bg", "background")
	corner(bar, 3)
	addStroke(bar, 1)
	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.ZIndex = 58
	fill.Parent = bar
	track(fill, "bg", "accent")
	corner(fill, 3)
	local function fmt(v)
		local snapped = step and (math.floor(v / step + 0.5) * step) or v
		local nearest = math.floor(snapped + 0.5)
		if math.abs(snapped - nearest) < 0.001 then
			return tostring(nearest)
		end
		return (string.format("%.2f", snapped):gsub("0+$", ""):gsub("%.$", ""))
	end
	local function show(v)
		local r = math.clamp((v - minV) / math.max(maxV - minV, 0.001), 0, 1)
		fill.Size = UDim2.new(r, 0, 1, 0)
		val.Text = fmt(v) .. (suffix or "")
	end
	watch(function()
		show(get())
		fill.BackgroundColor3 = THEME.accent.c
		fill.BackgroundTransparency = THEME.accent.t
	end)
	local function applyAt(x)
		local r = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local v = minV + r * (maxV - minV)
		if step then
			v = math.floor(v / step + 0.5) * step
		elseif maxV - minV > 20 then
			v = math.floor(v + 0.5)
		else
			v = math.floor(v * 10 + 0.5) / 10
		end
		v = math.clamp(v, minV, maxV)
		set(v)
		show(v)
	end
	bar.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		applyAt(input.Position.X)
		pointer = function(pos)
			applyAt(pos.X)
		end
	end)
end

