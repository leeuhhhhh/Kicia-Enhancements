	local lay = Instance.new("UIListLayout")
	lay.SortOrder = Enum.SortOrder.LayoutOrder
	lay.Padding = UDim.new(0, 6)
	lay.Parent = f
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 12)
	pad.PaddingRight = UDim.new(0, 12)
	pad.Parent = f
	local function sync()
		local h = lay.AbsoluteContentSize.Y + 20
		if h < 36 then
			h = 36
		end
		f.Size = UDim2.new(1, -2, 0, h)
	end
	lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(sync)
	cardSyncs[#cardSyncs + 1] = sync
	local n = 0
	local function order()
		n += 1
		return n
	end
	if title then
		local h = textOf(f, title, "accent", 14, true)
		h.LayoutOrder = order()
		h.Size = UDim2.new(1, 0, 0, 20)
		h.TextYAlignment = Enum.TextYAlignment.Center
		h.ZIndex = 56
	end
	return f, order
end

