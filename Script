local origWorld
local worldCC
local worldApplying = false

local function snapshotWorld()
	if origWorld then
		return
	end
	local skyInst = Lighting:FindFirstChildOfClass("Sky")
	origWorld = {
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		Brightness = Lighting.Brightness,
		ClockTime = Lighting.ClockTime,
		FogColor = Lighting.FogColor,
		FogStart = Lighting.FogStart,
		FogEnd = Lighting.FogEnd,
		sky = nil,
	}
	if skyInst then
		origWorld.sky = {
			SkyboxBk = skyInst.SkyboxBk,
			SkyboxDn = skyInst.SkyboxDn,
			SkyboxFt = skyInst.SkyboxFt,
			SkyboxLf = skyInst.SkyboxLf,
			SkyboxRt = skyInst.SkyboxRt,
			SkyboxUp = skyInst.SkyboxUp,
			StarCount = skyInst.StarCount,
			SunAngularSize = skyInst.SunAngularSize,
			MoonAngularSize = skyInst.MoonAngularSize,
			SunTextureId = skyInst.SunTextureId,
			MoonTextureId = skyInst.MoonTextureId,
		}
	end
end

local function applySkyProps(skyInst, props)
	if not skyInst or not props then
		return
	end
	for _, key in ipairs({ "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp", "StarCount", "SunAngularSize", "MoonAngularSize", "SunTextureId", "MoonTextureId" }) do
		if props[key] ~= nil then
			pcall(function()
				skyInst[key] = props[key]
			end)
		end
	end
end

local function restoreWorld()
	snapshotWorld()
	worldApplying = true
	local o = origWorld
	pcall(function()
		Lighting.Ambient = o.Ambient
		Lighting.OutdoorAmbient = o.OutdoorAmbient
		Lighting.Brightness = o.Brightness
		Lighting.ClockTime = o.ClockTime
		Lighting.FogColor = o.FogColor
		Lighting.FogStart = o.FogStart
		Lighting.FogEnd = o.FogEnd
	end)
	if worldCC then
		pcall(function()
			worldCC:Destroy()
		end)
		worldCC = nil
	end
	local skyInst = Lighting:FindFirstChildOfClass("Sky")
	if o.sky and skyInst then
		applySkyProps(skyInst, o.sky)
	end
	worldApplying = false
end

local function applyWorld()
	snapshotWorld()
	if not CFG.worldEnabled then
		restoreWorld()
		return
	end
	worldApplying = true
	pcall(function()
		Lighting.ClockTime = CFG.worldClock
		Lighting.Brightness = CFG.worldBrightness
		Lighting.FogStart = CFG.worldFogStart
		Lighting.FogEnd = math.max(CFG.worldFogEnd, CFG.worldFogStart + 10)
	end)
	if CFG.worldSky == "Gray" then
		pcall(function()
			Lighting.Ambient = Color3.fromRGB(140, 140, 140)
			Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 140)
			Lighting.FogColor = Color3.fromRGB(160, 160, 160)
			Lighting.ClockTime = 12
		end)
	end
	local skyInst = Lighting:FindFirstChildOfClass("Sky")
	if not skyInst then
		skyInst = Instance.new("Sky")
		skyInst.Name = "KE_Sky"
		skyInst.Parent = Lighting
	end
	if CFG.worldSky ~= "Default" and SKY_PRESETS[CFG.worldSky] then
		applySkyProps(skyInst, SKY_PRESETS[CFG.worldSky])
	elseif origWorld and origWorld.sky then
		applySkyProps(skyInst, origWorld.sky)
	end
	if not worldCC or not worldCC.Parent then
		worldCC = Instance.new("ColorCorrectionEffect")
		worldCC.Name = "KE_WorldCC"
		worldCC.Parent = Lighting
	end
	worldCC.Saturation = CFG.worldSaturation
	worldCC.Contrast = CFG.worldContrast
	worldCC.Enabled = true
	worldApplying = false
end

