on(UserInputService.InputBegan, function(input)
	if not dropFrame or input.UserInputType ~= Enum.UserInputType.MouseButton1 then
		return
	end
	local p = input.Position
	local function inside(obj)
		if not obj or not obj.Parent then
			return false
		end
		local ap, asz = obj.AbsolutePosition, obj.AbsoluteSize
		return p.X >= ap.X and p.X <= ap.X + asz.X and p.Y >= ap.Y and p.Y <= ap.Y + asz.Y
	end
	if inside(dropFrame) or inside(dropAnchor) then
		return
	end
	closeDrop()
end)

