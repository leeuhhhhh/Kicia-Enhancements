local function teamToken(plr)
	if not plr then
		return nil
	end
	local function usable(v)
		if v == nil or v == false or v == "" or v == 0 or v == "0" or v == "Neutral" or v == "FFA" then
			return nil
		end
		return v
	end
	local v = usable(plr:GetAttribute("TeamID")) or usable(plr:GetAttribute("TeamId"))
	local c = plr.Character
	if v == nil and c then
		v = usable(c:GetAttribute("TeamID")) or usable(c:GetAttribute("TeamId"))
	end
	if v ~= nil then
		return v
	end
	if plr.Team and not plr.Neutral then
		return plr.Team
	end
	return nil
end

local function skipped(plr)
	if not plr or plr == LP then
		return true
	end
	if whitelist[plr.UserId] then
		return true
	end
	if CFG.teamCheck then
		local a, b = teamToken(LP), teamToken(plr)
		if a ~= nil and a == b then
			return true
		end
	end
	return false
end

local function tooFar(plr)
	if CFG.ignoreDistance <= 0 or not hrp then
		return false
	end
	local r = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not r then
		return true
	end
	return (r.Position - hrp.Position).Magnitude > CFG.ignoreDistance
end

local function getTargetCharacter()
	if not hrp then
		return nil
	end
	if CFG.priorityUserId then
		local p = Players:GetPlayerByUserId(CFG.priorityUserId)
		if p and not skipped(p) and alive(p) and not tooFar(p) then
			return p.Character
		end
	end
	local closest, minDist = nil, math.huge
	for _, other in ipairs(Players:GetPlayers()) do
		if not skipped(other) and alive(other) and not tooFar(other) then
			local r = other.Character and other.Character:FindFirstChild("HumanoidRootPart")
			if r then
				local d = (r.Position - hrp.Position).Magnitude
				if d < minDist then
					minDist = d
					closest = other.Character
				end
			end
		end
	end
	return closest
end

local SAMPLE = { "Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg" }
local visParams = RaycastParams.new()
visParams.FilterType = Enum.RaycastFilterType.Exclude
local trigParams = RaycastParams.new()
trigParams.FilterType = Enum.RaycastFilterType.Exclude

local function partVisible(part)
	if not part or not Camera then
		return false
	end
	visParams.FilterDescendantsInstances = { char, Camera }
	local origin = Camera.CFrame.Position
	local hit = workspace:Raycast(origin, part.Position - origin, visParams)
	if not hit then
		return true
	end
	return hit.Instance:IsDescendantOf(part.Parent)
end

local function is35Visible(character)
	local seen, total = 0, 0
	for _, name in ipairs(SAMPLE) do
		local p = character:FindFirstChild(name)
		if p then
			total += 1
			if partVisible(p) then
				seen += 1
			end
		end
	end
	return total > 0 and (seen / total) >= 0.35
end

local function getAimPart(character, mode)
	if mode == "Head" then
		return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	elseif mode == "Torso" then
		return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function screenDist(worldPos)
	local v, onScreen = Camera:WorldToViewportPoint(worldPos)
	if not onScreen or v.Z < 0 then
		return math.huge, v, false
	end
	local c = Camera.ViewportSize / 2
	return (Vector2.new(v.X, v.Y) - c).Magnitude, v, true
end

local function pickTarget(radiusPx, pointMode, visCheck)
	local best, bestD = nil, radiusPx
	for _, plr in ipairs(Players:GetPlayers()) do
		if not skipped(plr) and alive(plr) then
			local c = plr.Character
			local h = c:FindFirstChildOfClass("Humanoid")
			local low = CFG.healthCheck and h and h.Health < 0.1
			if not low and (not visCheck or is35Visible(c)) then
				local part = getAimPart(c, pointMode)
				if part then
					local d, _, onScreen = screenDist(part.Position)
					if onScreen and d < bestD then
						bestD = d
						best = part
					end
				end
			end
		end
	end
	return best
end

