local function buildWhitelistPage()
	local sc, ord = vscroll(pages.Whitelist)
	local players, op = card(sc, ord, "Players")
	local listed, ol = card(sc, ord, "Whitelisted")

	local names = Instance.new("Frame")
	names.BackgroundTransparency = 1
	names.Size = UDim2.new(1, 0, 0, 18)
	names.AutomaticSize = Enum.AutomaticSize.Y
	names.LayoutOrder = ol()
	names.ZIndex = 56
	names.Parent = listed
	local namesLay = Instance.new("UIListLayout")
	namesLay.SortOrder = Enum.SortOrder.LayoutOrder
	namesLay.Padding = UDim.new(0, 4)
	namesLay.Parent = names
	local empty = textOf(names, "Nobody is whitelisted.", "muted", 12, false)
	empty.Size = UDim2.new(1, 0, 0, 18)
	empty.LayoutOrder = 0
	empty.TextTruncate = Enum.TextTruncate.None
	empty.ZIndex = 57

	local list = Instance.new("Frame")
	list.BackgroundTransparency = 1
	list.Size = UDim2.new(1, 0, 0, 0)
	list.AutomaticSize = Enum.AutomaticSize.Y
	list.LayoutOrder = op()
	list.ZIndex = 56
	list.Parent = players
	local lay = Instance.new("UIListLayout")
	lay.SortOrder = Enum.SortOrder.LayoutOrder
	lay.Padding = UDim.new(0, 4)
	lay.Parent = list

	local function playerLabel(plr)
		local ok, text = pcall(function()
			local dn = tostring(plr.DisplayName or plr.Name or "Player"):gsub("[%c]", " ")
			local nm = tostring(plr.Name or "?"):gsub("[%c]", " ")
			return dn .. "  @" .. nm
		end)
		return ok and text or "Player"
	end

	rebuildWhitelist = function()
		if not list.Parent then
			return
		end
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		for _, c in ipairs(names:GetChildren()) do
			if c ~= empty and not c:IsA("UIListLayout") then
				c:Destroy()
			end
		end
		local any = false
		local ni = 0
		for uid, label in pairs(whitelist) do
			any = true
			ni += 1
			local b = Instance.new("TextButton")
			b.Text = tostring(label)
			b.Font = Enum.Font.Gotham
			b.TextSize = 12
			b.TextXAlignment = Enum.TextXAlignment.Left
			b.AutoButtonColor = false
			b.BackgroundTransparency = 1
			b.Size = UDim2.new(1, 0, 0, 18)
			b.LayoutOrder = ni
			b.ZIndex = 55
			b.Parent = names
			track(b, "text", "font")
			local id = uid
			b.MouseButton1Click:Connect(function()
				whitelist[id] = nil
				rebuildWhitelist()
			end)
		end
		empty.Visible = not any
		local i = 0
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP and plr.Parent == Players then
				i += 1
				local onW = whitelist[plr.UserId] ~= nil
				local row = Instance.new("Frame")
				row.Size = UDim2.new(1, 0, 0, 32)
				row.LayoutOrder = i
				row.BorderSizePixel = 0
				row.ZIndex = 54
				row.Parent = list
				track(row, "bg", "main")
				corner(row, 8)
				addStroke(row, 1.25)
				local lab = textOf(row, playerLabel(plr), "font", 12, false)
				lab.Position = UDim2.fromOffset(8, 0)
				lab.Size = UDim2.new(1, -96, 1, 0)
				lab.ZIndex = 55
				local b = Instance.new("TextButton")
				b.Text = onW and "Remove" or "Add"
				b.Font = Enum.Font.Gotham
				b.TextSize = 12
				b.AutoButtonColor = false
				b.Size = UDim2.fromOffset(72, 22)
				b.Position = UDim2.new(1, -80, 0.5, -11)
				b.BorderSizePixel = 0
				b.ZIndex = 55
				b.Parent = row
				track(b, "bg", onW and "danger" or "success")
				track(b, "text", "font")
				corner(b, 5)
				local uid = plr.UserId
				local shown = playerLabel(plr)
				b.MouseButton1Click:Connect(function()
					if whitelist[uid] then
						whitelist[uid] = nil
					else
						whitelist[uid] = shown
					end
					rebuildWhitelist()
				end)
			end
		end
		task.defer(syncCards)
		repaint()
	end
end

