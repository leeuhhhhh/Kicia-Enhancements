local function keHwid()
	local raw = ""
	pcall(function()
		if typeof(gethwid) == "function" then
			raw = tostring(gethwid())
		end
	end)
	if raw == "" or raw == "nil" then
		pcall(function()
			raw = tostring(game:GetService("RbxAnalyticsService"):GetClientId())
		end)
	end
	if not raw or raw == "" or raw == "nil" then
		raw = "unknown"
	end
	return raw
end

local function keLicense()
	local key = ""
	pcall(function()
		if typeof(script_key) == "string" then
			key = script_key
		end
	end)
	pcall(function()
		if key == "" and typeof(getgenv) == "function" then
			local g = getgenv().script_key
			if typeof(g) == "string" then
				key = g
			end
		end
	end)
	if key == "" or key == "{KEY}" or key == "Placeholder" then
		return true
	end
	local req = (typeof(request) == "function" and request)
		or (typeof(http_request) == "function" and http_request)
		or (typeof(syn) == "table" and syn.request)
	if typeof(req) ~= "function" then
		warn("[KE] This executor cannot send the license check.")
		return false
	end
	local ok, res = pcall(function()
		return req({
			Url = LICENSE_API,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({ key = key, hwid = keHwid() }),
		})
	end)
	if not ok or type(res) ~= "table" or type(res.Body) ~= "string" then
		warn("[KE] Could not reach the license server.")
		return false
	end
	local decoded
	pcall(function()
		decoded = HttpService:JSONDecode(res.Body)
	end)
	if type(decoded) ~= "table" or not decoded.valid then
		warn("[KE] License denied: " .. tostring(decoded and decoded.reason or res.StatusCode or "unknown"))
		return false
	end
	return true
end

if not keLicense() then
