local function sidebarContains(pos)
	local ap, asz = side.AbsolutePosition, side.AbsoluteSize
	return pos.X >= ap.X and pos.X <= ap.X + asz.X and pos.Y >= ap.Y and pos.Y <= ap.Y + asz.Y
end
noteSidebarHover = function(pos)
	if not shell.Visible then
		return
	end
	local inside = sidebarContains(pos)
	if inside then
		if not hoverSide then
			hoverSide = true
			hoverGen += 1
			local gen = hoverGen
			task.delay(0.325, function()
				if hoverSide and gen == hoverGen and shell.Visible and not killed then
					setSidebar(true, false)
				end
			end)
		end
	elseif hoverSide then
		hoverSide = false
		hoverGen += 1
		setSidebar(false, false)
	end
end
on(UserInputService.InputChanged, function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseMovement then
		return
	end
	noteSidebarHover(input.Position)
end)

