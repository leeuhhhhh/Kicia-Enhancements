local function jumpVelocity()
	if not hum then
		return 50
	end
	if hum.UseJumpPower then
		return math.max(hum.JumpPower, 40)
	end
	local h = hum.JumpHeight
	if h < 1 then
		h = 7.2
	end
	return math.sqrt(2 * workspace.Gravity * h)
end

