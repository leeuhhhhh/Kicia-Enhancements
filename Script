		local allowOrbit = CFG.orbitActive and (not CFG.voidActive or comboPhase == "orbit") and (not CFG.translocate or otPhase == "orbit")
		if allowOrbit and selfAlive() and not isVoidingFar then
			local target = getTargetCharacter()
			local thrp = target and target:FindFirstChild("HumanoidRootPart")
			if thrp then
				angle += CFG.orbitSpeed * 1.8
				local height = CFG.orbitMinY + (CFG.orbitMaxY - CFG.orbitMinY) * (0.5 + 0.5 * math.sin(tick() * 2.2))
				local dist = CFG.orbitDist * (0.9 + 0.1 * math.sin(tick() * 1.4))
				hrp.CFrame = thrp.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, height, dist)
			end
		end
		RunService.Heartbeat:Wait()
	end
end)

