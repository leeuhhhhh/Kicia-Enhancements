on(RunService.Heartbeat, function()
	if killed or not selfAlive() then
		return
	end
	if (CFG.noclip or CFG.translocate) and char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				if collideState[part] == nil then
					collideState[part] = true
				end
				part.CanCollide = false
			end
		end
	end
	if CFG.speedwalk and hum and hrp then
		hum.WalkSpeed = CFG.speedValue
		local moveDir = hum.MoveDirection
		if moveDir.Magnitude > 0.05 then
			local vel = hrp.AssemblyLinearVelocity
			hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * CFG.speedValue, vel.Y, moveDir.Z * CFG.speedValue)
		end
	end
	if CFG.flight and hrp then
		local dir = Vector3.zero
		local look = Camera.CFrame.LookVector
		local right = Camera.CFrame.RightVector
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += look end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= look end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= right end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += right end
		local vy = 0
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vy = CFG.flightSpeed end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vy = -CFG.flightSpeed end
		if dir.Magnitude > 0 then
			dir = Vector3.new(dir.X, 0, dir.Z).Unit * CFG.flightSpeed
		end
		hrp.AssemblyLinearVelocity = Vector3.new(dir.X, vy ~= 0 and vy or 0, dir.Z)
	elseif slideHeld and CFG.slideMult > 1 and hrp then
		local v = hrp.AssemblyLinearVelocity
		local flat = Vector3.new(v.X, 0, v.Z)
		if flat.Magnitude > 10 then
			if not slideBase then
				slideBase = flat.Magnitude
			end
			local dir = flat.Unit
			local spd = slideBase * CFG.slideMult
			hrp.AssemblyLinearVelocity = Vector3.new(dir.X * spd, v.Y, dir.Z * spd)
		end
	end
	if CFG.antiAim and char and hrp then
		local upper = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
		local neck = upper and (upper:FindFirstChild("Neck") or upper:FindFirstChild("neck"))
		local head = char:FindFirstChild("Head")
		if neck and neck:IsA("Motor6D") then
			if savedNeck ~= neck then
				savedNeck = neck
				savedNeckC0 = neck.C0
			end
			neck.C0 = CFrame.new(0, -1.7, 0.15) * CFrame.Angles(math.rad(89), tick() * 22, 0)
		end
		if head and head:IsA("BasePart") then
			head.CanCollide = false
			head.AssemblyLinearVelocity = Vector3.zero
			head.AssemblyAngularVelocity = Vector3.zero
			head.CFrame = hrp.CFrame * CFrame.new(0, -3.1, 0) * CFrame.Angles(math.rad(90), tick() * 22, 0)
		end
	elseif savedNeck and savedNeck.Parent and savedNeckC0 then
		pcall(function()
			savedNeck.C0 = savedNeckC0
		end)
		savedNeck = nil
		savedNeckC0 = nil
	end
end)

