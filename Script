local function openLink(url)
	local opened = false
	local function try(fn)
		if opened then
			return
		end
		local ok = pcall(fn)
		if ok then
			opened = true
		end
	end
	try(function()
		if type(openurl) == "function" then
			openurl(url)
		else
			error("no openurl")
		end
	end)
	try(function()
		if type(open_url) == "function" then
			open_url(url)
		else
			error("no open_url")
		end
	end)
	try(function()
		if syn and type(syn.open_url) == "function" then
			syn.open_url(url)
		else
			error("no syn")
		end
	end)
	try(function()
		game:GetService("GuiService"):OpenBrowserWindow(url)
	end)
	if opened then
		return true
	end
	if type(setclipboard) == "function" then
		pcall(setclipboard, url)
		return false
	end
	return false
end

