local function buttonRow(parent, order, specs)
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 28)
	row.LayoutOrder = order()
	row.ZIndex = 56
	row.Parent = parent
	local n = #specs
	for i, spec in ipairs(specs) do
		local b = Instance.new("TextButton")
		b.Text = spec[1]
		b.Font = Enum.Font.GothamBold
		b.TextSize = 12
		b.AutoButtonColor = false
		b.BorderSizePixel = 0
		b.Size = UDim2.new(1 / n, -5, 1, 0)
		b.Position = UDim2.new((i - 1) / n, 0, 0, 0)
		b.ZIndex = 57
		b.Parent = row
		local role = spec[2]
		track(b, "bg", role)
		track(b, "text", "font")
		corner(b, 4)
		addStroke(b, 1.25)
		b.MouseButton1Click:Connect(spec[3])
	end
	return row
end

local function cleanName(s)
	return (s or ""):gsub("[^%w%-%_ ]", ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function fitList(frame, layout)
	local function sync()
		frame.Size = UDim2.new(1, 0, 0, layout.AbsoluteContentSize.Y)
	end
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(sync)
	cardSyncs[#cardSyncs + 1] = sync
end

