local HAS_DRAW = Drawing ~= nil
local pool = {}

local function drawObj(kind)
	if not HAS_DRAW then
		return nil
	end
	local o = Drawing.new(kind)
	o.Visible = false
	return o
end

local function ensurePool(uid)
	local p = pool[uid]
	if p then
		return p
	end
	p = {
		box = drawObj("Square"),
		fill = drawObj("Square"),
		name = drawObj("Text"),
		dist = drawObj("Text"),
		hpBg = drawObj("Square"),
		hp = drawObj("Square"),
		hpTx = drawObj("Text"),
		corners = {},
		edges = {},
	}
	if HAS_DRAW then
		for i = 1, 8 do p.corners[i] = drawObj("Line") end
		for i = 1, 12 do p.edges[i] = drawObj("Line") end
		if p.box then p.box.Filled = false p.box.Thickness = 1.4 end
		if p.fill then p.fill.Filled = true p.fill.Transparency = 0.82 end
		if p.name then p.name.Size = 13 p.name.Center = true p.name.Outline = true end
		if p.dist then p.dist.Size = 12 p.dist.Center = true p.dist.Outline = true end
		if p.hpTx then p.hpTx.Size = 16 p.hpTx.Outline = true end
		if p.hpBg then p.hpBg.Filled = true p.hpBg.Color = Color3.fromRGB(20, 20, 20) end
		if p.hp then p.hp.Filled = true p.hp.Color = Color3.fromRGB(80, 220, 120) end
	end
	pool[uid] = p
	return p
end

local function hidePool(p)
	if not p then
		return
	end
	local function off(o)
		if o then
			o.Visible = false
		end
	end
	off(p.box) off(p.fill) off(p.name) off(p.dist) off(p.hpBg) off(p.hp) off(p.hpTx)
	for _, o in ipairs(p.corners) do off(o) end
	for _, o in ipairs(p.edges) do off(o) end
end

local function wipeDraw(o)
	if not o then
		return
	end
	pcall(function() o.Visible = false end)
	pcall(function() o:Remove() end)
	pcall(function() o:Destroy() end)
end

function clearPool()
	for _, p in pairs(pool) do
		wipeDraw(p.box) wipeDraw(p.fill) wipeDraw(p.name) wipeDraw(p.dist)
		wipeDraw(p.hpBg) wipeDraw(p.hp) wipeDraw(p.hpTx)
		for _, o in ipairs(p.corners) do wipeDraw(o) end
		for _, o in ipairs(p.edges) do wipeDraw(o) end
	end
	pool = {}
end

