local function cleanKeyName(v)
	if type(v) ~= "string" then
		return nil
	end
	v = v:gsub("^Enum%.KeyCode%.", ""):gsub("^Enum%.UserInputType%.", "")
	if v == "" then
		return nil
	end
	return v
end

