-- Aimbot + Triggerbot + FOV
local lastTrigger = 0

task.spawn(function()
    while not killed do
        -- FOV Circle
        if showFovCircle then
            local px = fovRadius * 2
            fovCircle.Size = UDim2.new(0, px, 0, px)
            fovCircle.Visible = true
        else
            fovCircle.Visible = false
        end

        local target = getAimTarget()

        -- Aimbot (mouse lock)
        if aimbotEnabled and target and aimbotStrength > 0 then
            local screenPos, onScreen = camera:WorldToViewportPoint(target.Position)
            if onScreen then
                local screenCenter = camera.ViewportSize / 2
                local deltaX = screenPos.X - screenCenter.X
                local deltaY = screenPos.Y - screenCenter.Y

                local strength = aimbotStrength / 100
                -- At 100 strength → almost perfect lock
                local smooth = 0.15 + (0.85 * strength)
                mousemoverel(deltaX * smooth, deltaY * smooth)
            end
        end

        -- Triggerbot (improved)
        if triggerbotEnabled then
            local hitPlayer = nil

            -- Method 1: Mouse.Target
            if mouse.Target then
                local model = mouse.Target:FindFirstAncestorOfClass("Model")
                if model then
                    local plr = Players:GetPlayerFromCharacter(model)
                    local hrp = model:FindFirstChild("HumanoidRootPart")
                    if plr and plr ~= player and hrp and not whitelisted[plr.UserId] then
                        if mouse.Target == hrp or mouse.Target.Name == "HumanoidRootPart" or mouse.Target:IsDescendantOf(hrp) then
                            hitPlayer = plr
                        end
                    end
                end
            end

            -- Method 2: Center screen raycast (more reliable)
            if not hitPlayer then
                local screenCenter = camera.ViewportSize / 2
                local ray = camera:ViewportPointToRay(screenCenter.X, screenCenter.Y)
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = {character}
                local result = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
                if result and result.Instance then
                    local model = result.Instance:FindFirstAncestorOfClass("Model")
                    if model then
                        local plr = Players:GetPlayerFromCharacter(model)
                        local hrp = model:FindFirstChild("HumanoidRootPart")
                        if plr and plr ~= player and hrp and not whitelisted[plr.UserId] then
                            if result.Instance == hrp or result.Instance.Name == "HumanoidRootPart" then
                                hitPlayer = plr
                            end
                        end
                    end
                end
            end

            if hitPlayer and (tick() - lastTrigger) > reactionTime then
                lastTrigger = tick()
                -- Try multiple click methods for better compatibility
                pcall(function()
                    mouse1click()
                end)
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.wait()
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end)
            end
        end

        RunService.RenderStepped:Wait()
    end
end)

