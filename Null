        page.Visible = (n == name)
        local btn = tabs[n]
        if btn then
            btn.BackgroundColor3 = (n == name) and Colors.Accent or Colors.Button
            btn.TextColor3 = (n == name) and Color3.fromHex("#111") or Colors.DimText
