local function setUIVisible(visible)
    if animating then return end
    animating = true
    uiVisible = visible
    if visible then
        statusPanel.Visible = false
        main.Visible = true
        main.BackgroundTransparency = 1
        uiScale.Scale = 0.85
        TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency = 0}):Play()
        TweenService:Create(uiScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        task.delay(0.3, function() animating = false end)
    else
        TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
        TweenService:Create(uiScale, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Scale = 0.85}):Play()
        task.delay(0.3, function()
            main.Visible = false
            main.BackgroundTransparency = 0
            uiScale.Scale = 1
            statusPanel.Visible = true
            animating = false
        end)
    end
end
