local function createSlider(parent, text, minV, maxV, default, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 34)
    container.BackgroundTransparency = 1
    container.LayoutOrder = #parent:GetChildren()
    container.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.55, 0, 0, 13)
    label.BackgroundTransparency = 1
    label.Text = text
    label.Font = Enum.Font.Gotham
    label.TextSize = 11
    label.TextColor3 = Colors.DimText
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(0.4, 0, 0, 13)
    val.Position = UDim2.new(0.58, 0, 0, 0)
    val.BackgroundTransparency = 1
    val.Text = tostring(math.floor(default * 100) / 100)
    val.Font = Enum.Font.GothamMedium
    val.TextSize = 11
    val.TextColor3 = Colors.Text
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Parent = container

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, 0, 0, 5)
    bar.Position = UDim2.new(0, 0, 0, 18)
    bar.BackgroundColor3 = Color3.fromHex("#2A2A32")
    bar.Parent = container
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(math.clamp((default - minV) / (maxV - minV), 0, 1), 0, 1, 0)
    fill.BackgroundColor3 = Colors.Accent
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 11, 0, 11)
    knob.Position = UDim2.new(fill.Size.X.Scale, -5.5, 0.5, -5.5)
    knob.BackgroundColor3 = Colors.Text
    knob.Parent = bar
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local sliding = false
    local function set(v)
        v = math.clamp(v, minV, maxV)
        local r = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(r, 0, 1, 0)
        knob.Position = UDim2.new(r, -5.5, 0.5, -5.5)
        val.Text = tostring(math.floor(v * 100) / 100)
        if callback then callback(v) end
    end

    bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true end end)
    knob.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then
            local r = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            set(minV + r * (maxV - minV))
        end
    end)
end

