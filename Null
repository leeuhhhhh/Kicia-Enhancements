local function refreshLists()
    for _, c in ipairs(priorityList:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    for _, c in ipairs(whitelistList:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    local ph, wh = 0, 0
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local function addRow(parent, isPrio)
                local row = Instance.new("Frame")
                row.Size = UDim2.new(1, -4, 0, 22)
                row.BackgroundColor3 = Color3.fromHex("#18181F")
                row.Parent = parent
                Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)

                local n = Instance.new("TextLabel")
                n.Size = UDim2.new(0.55, 0, 1, 0)
                n.Position = UDim2.new(0, 7, 0, 0)
                n.BackgroundTransparency = 1
                n.Text = other.DisplayName
                n.Font = Enum.Font.Gotham
                n.TextSize = 11
                n.TextColor3 = Colors.Text
                n.TextXAlignment = Enum.TextXAlignment.Left
                n.TextTruncate = Enum.TextTruncate.AtEnd
                n.Parent = row

                local b = Instance.new("TextButton")
                b.Size = UDim2.new(0, isPrio and 48 or 58, 0, 16)
                b.Position = UDim2.new(1, isPrio and -54 or -64, 0.5, -8)
                b.Font = Enum.Font.GothamMedium
                b.TextSize = 10
                b.TextColor3 = Colors.Text
                b.Parent = row
                Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)

                if isPrio then
                    b.Text = priorityUserId == other.UserId and "Clear" or "Set"
                    b.BackgroundColor3 = priorityUserId == other.UserId and Colors.Danger or Colors.Success
                    b.MouseButton1Click:Connect(function()
                        priorityUserId = priorityUserId == other.UserId and nil or other.UserId
                        refreshLists()
                    end)
                else
                    b.Text = whitelisted[other.UserId] and "Remove" or "Add"
                    b.BackgroundColor3 = whitelisted[other.UserId] and Colors.Danger or Colors.Success
                    b.MouseButton1Click:Connect(function()
                        if whitelisted[other.UserId] then whitelisted[other.UserId] = nil
                        else whitelisted[other.UserId] = true end
                        refreshLists()
                    end)
                end
                return 25
            end
            ph = ph + addRow(priorityList, true)
            wh = wh + addRow(whitelistList, false)
        end
    end
    priorityList.CanvasSize = UDim2.new(0, 0, 0, ph)
    whitelistList.CanvasSize = UDim2.new(0, 0, 0, wh)
end
