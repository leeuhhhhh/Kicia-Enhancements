local function drawLine(from, to, parent)
    local a = camera:WorldToViewportPoint(from)
    local b = camera:WorldToViewportPoint(to)
    if a.Z < 0 or b.Z < 0 then return end
    local dist = (Vector2.new(a.X, a.Y) - Vector2.new(b.X, b.Y)).Magnitude
    if dist < 1 then return end
    local mid = (Vector2.new(a.X, a.Y) + Vector2.new(b.X, b.Y)) / 2
    local line = Instance.new("Frame")
    line.Size = UDim2.new(0, dist, 0, 1.2)
    line.Position = UDim2.new(0, mid.X - dist/2, 0, mid.Y)
    line.BackgroundColor3 = Colors.Accent
    line.BorderSizePixel = 0
    line.Rotation = math.deg(math.atan2(b.Y - a.Y, b.X - a.X))
    line.Parent = parent
end

